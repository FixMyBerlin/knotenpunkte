{
  "name": "knotenpunkte",
  "version": "0.0.0",
  "private": true,
  "description": "Rate junction nodes one after another (Zustand nach OSM)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --bun vite dev --host 127.0.0.1 --strictPort",
    "dev-netz": "FORCE_COLOR=1 bun --bun vite dev --config netzanpassungen/vite.config.ts",
    "build": "FORCE_COLOR=1 bun --bun vite build && FORCE_COLOR=1 bun --bun vite build --config netzanpassungen/vite.config.ts",
    "preview": "FORCE_COLOR=1 bun --bun vite preview --host 127.0.0.1 --strictPort",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p netzanpassungen/tsconfig.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests src shared && vitest run --passWithNoTests --config netzanpassungen/vite.config.ts",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip-warn",
    "e2e": "playwright test --project=chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@osm-editor-kit/maplibre-editor-layer-index": "0.1.14",
    "@osm-editor-kit/street-imagery": "0.1.0-alpha.10",
    "@osm-editor-kit/street-imagery-react": "0.1.0-alpha.13",
    "@rapideditor/country-coder": "5.6.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^6.13.0",
    "motion": "^13.5.1",
    "osm-api": "^4.0.1",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.4.2",
    "eslint-plugin-compat": "^7.0.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "^7.0.2"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
